# Astra Taro — пример переменных окружения.
# ВАЖНО: сюда нельзя вставлять реальные ключи, если файл будет попадать в GitHub.

BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=123456789

AI_PROVIDER=gemini
AI_FALLBACK_1=groq
AI_FALLBACK_2=openrouter
AI_FALLBACK_3=ollama

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

DATABASE_PATH=database/astra_taro.db
WEBAPP_URL=http://localhost:8000
DEV_ALLOW_UNVERIFIED_WEBAPP=true
HOST=0.0.0.0
PORT=8000
